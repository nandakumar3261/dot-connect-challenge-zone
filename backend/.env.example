# Copy this file to .env and fill in your own values.

# Local MongoDB — default install listens here:
MONGO_URI=mongodb://127.0.0.1:27017/dotconnect

# Any long random string — used to sign staff sign-in tokens:
JWT_SECRET=change_this_to_a_long_random_string

# Port the server runs on (serves the API + both websites):
PORT=5000

# Used once by seedAdmin.js to create the first administrator account:
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Thub@123

# Max size (in MB) accepted for a single video upload (routes/videos.js).
VIDEO_MAX_MB=250
